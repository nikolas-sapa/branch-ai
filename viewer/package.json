{
  "name": "branch-viewer",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "concurrently \"node ws-server.mjs\" \"next dev --webpack -p 7432 --hostname 127.0.0.1\"",
    "ws": "node ws-server.mjs",
    "next-dev": "next dev --webpack -p 7432 --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@xyflow/react": "^12.3.0",
    "@y/websocket-server": "0.1.1",
    "nanoid": "^5.1.9",
    "next": "16.3.8",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "ws": "^8.20.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.2.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
